# ── METNMAT customer-agent (chatbot) environment ──────────────────────────────
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets.
# In production these should come from a secret manager, not a file on disk.

# ── Core ──────────────────────────────────────────────────────────────────────
MONGODB_URI=
# Comma-separated custom DNS servers for the Mongo SRV lookup (optional; some
# networks need this). Leave blank to use the system resolver.
MONGODB_DNS_SERVERS=
GROQ_API_KEY=
PORT=3001
PUBLIC_URL=http://localhost:3001

# ── Auth / session ────────────────────────────────────────────────────────────
# Signs the chat-widget session JWTs. MUST be a long random value and MUST be set
# in production (the app should fail fast if it is missing — do not ship a default).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Secret an agent/staff console must present as the `x-agent-key` header to mint
# an agent token or list all conversations. UNSET → those endpoints are DISABLED
# (fail closed). Set this only if you use the human-agent console.  openssl rand -hex 32
AGENT_API_KEY=

# ── CORS / embedding ──────────────────────────────────────────────────────────
# Comma-separated list of EXACT origins allowed to call the widget API and embed
# the chat iframe. Do NOT use "*" in production.
# e.g. ALLOWED_ORIGINS=https://www.metnmat.com,https://metnmat.com
ALLOWED_ORIGINS=https://www.metnmat.com
# Sites allowed to frame the chat iframe (CSP frame-ancestors, space-separated).
# Defaults to the METNMAT domains if unset.
WIDGET_FRAME_ANCESTORS='self' https://www.metnmat.com https://metnmat.com

# ── Rate limiting (shared store) ──────────────────────────────────────────────
# Upstash Redis REST creds — distributed rate limiting on /widget/* across all
# instances; falls back to in-memory if unset. From console.upstash.com → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Meta webhook signature verification (REQUIRED for production) ──────────────
# App Secrets used to verify the X-Hub-Signature-256 HMAC on inbound webhooks so
# forged POSTs can't drive the bot. Find them in the Meta App dashboard.
META_APP_SECRET=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_SECRET=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
Meta_WA_accessToken=
Meta_WA_SenderPhoneNumberId=
Meta_WA_wabaId=
Meta_WA_VerfyToken=
WHATSAPP_WEBHOOK_URL=

# ── Facebook Messenger ────────────────────────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v20.0

# ── Instagram DM ──────────────────────────────────────────────────────────────
Meta_IG_VerifyToken=
Meta_IG_AccessToken=

# ── Optional — not required for the Metnmat chatbot ───────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
