# Copy this file to  secrets.env  (gitignored) and fill in REAL / rotated values.
# Format: KEY=VALUE  (no quotes, no spaces around =). Leave a line blank to skip it.
# ⚠️ Rotate everything that ever passed through chat before go-live.

# ── Shared ───────────────────────────────────────────────────────────────────
MONGODB_URI=
INTERNAL_API_KEY=
# Dedicated key for the website→CMS session-minting call (Google sign-in).
# Generate: openssl rand -hex 32. Set the SAME value on website + dashboard.
# Leave blank to fall back to INTERNAL_API_KEY (works, but wider blast radius).
CMS_OAUTH_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
RESEND_API_KEY=

# ── Website (payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Website (Google Sign-In) ─────────────────────────────────────────────────
# Web OAuth client from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must include: https://www.metnmat.com/api/account/google/callback
# Leave blank to disable Google sign-in (the button then shows a graceful error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Dashboard / Payload CMS ──────────────────────────────────────────────────
PAYLOAD_SECRET=
PAYLOAD_PIN_PEPPER=5970

# ── Chatbot ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
JWT_SECRET=
# WhatsApp Cloud API (optional — leave blank if not live yet)
Meta_WA_accessToken=
Meta_WA_SenderPhoneNumberId=
Meta_WA_wabaId=
Meta_WA_VerfyToken=

# ── Supabase ── REMOVED. Media was migrated to GCS (gs://metnmat-media-prod);
# Supabase is no longer used anywhere. Nothing to fill here.
